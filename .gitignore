# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments. The project's environment lives outside the checkout (run.ps1); this
# line keeps a .venv created by a bare `uv` call from ever reaching a commit.
.venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# LRCC: secrets and review material must never be committed (PRINCIPLES 6 and 8).
.env
# A person's configuration sits beside their .env (ADR-0015) and names their workspace.
# Only the example is versioned.
/config*
!/config.example.yaml
*.duckdb
*.duckdb.wal
*.pdf
